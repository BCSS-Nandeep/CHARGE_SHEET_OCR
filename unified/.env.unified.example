# Settings of the unified layer. Put any of these in .env (next to the IR_OCR settings, which are unchanged) or in the
# environment. All are optional; the values shown are the defaults.

# Where the unified registry (registry.db), the kept original uploads and the charge-sheet worker's own database and
# uploads live. The IR_OCR database / uploads and the original CHARGE_SHEET_OCR folders are never used or modified.
# UNIFIED_DATA_DIR=./data/unified

# The charge-sheet worker: the unmodified CHARGE_SHEET_OCR snapshot, run as its own process on the loopback interface.
# CS_WORKER_URL=http://127.0.0.1:8101
# CS_WORKER_MANAGE=true                  # start/stop it from here; false = you run it (and set CS_WORKER_API_KEY if auth is on)
# CS_WORKER_AUTOSTART=true               # start it when the application starts (otherwise on first use)
# CS_WORKER_PYTHON=                      # interpreter with PaddleOCR; default: vendor\charge_sheet_ocr\.venv, else this one
# CS_WORKER_DIR=./vendor/charge_sheet_ocr
# CS_WORKER_STARTUP_SECONDS=120
# CS_WORKER_API_KEY=

# Its OCR / vision-model / database settings come from vendor/charge_sheet_ocr/.env (a copy of the original project's
# .env; git-ignored), exactly as when it ran alone. The unified layer only overrides: bind address/port, database and
# upload folders, and the authentication keys (taken from this application's own API_KEY / API_KEYS).

# Document-type detection
# CLASSIFY_OCR=true                      # OCR the top of the first page of files with no text layer (~30-60 s on CPU)
# CLASSIFY_MIN_CONFIDENCE=0.55           # below this a person must choose the type
# CLASSIFY_MARGIN=0.25                   # required lead over the other form when both look plausible
# CLASSIFY_PROBE_PAGES=2                 # pages whose text layer is read
# CLASSIFY_PROBE_TIMEOUT_SECONDS=240

# Person images: IR_PERSON_IMAGES_OUTPUT=<folder>   (default ./output; also holds each document's report_result.json)
