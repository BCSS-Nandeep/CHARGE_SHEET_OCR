# Interrogation Report Extraction Service — local / private deployment only
# Copy to .env and adjust. Never commit real secrets.

APP_NAME=Interrogation Report Extraction Service
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Database: sqlite (default) or postgresql
DATABASE_URL=sqlite:///./data/ir_reports.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/ir_reports

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
MAX_PAGES=200
# Days after which files, extracted results and corrections are deleted (0 = keep)
RETENTION_DAYS=90

# Authentication
# ENABLE_AUTH=false → only loopback (127.0.0.1) clients are served, as an
#   unauthenticated "operator"; results can NOT be marked verified.
# ENABLE_AUTH=true  → every API call needs a key in API_KEY_HEADER.
ENABLE_AUTH=false
API_KEY_HEADER=X-API-Key
# Admin key (user "default"). At least 16 characters; example values are refused.
API_KEY=
# Named keys with roles (viewer < operator < reviewer < admin), ';'-separated:
# API_KEYS=alice:<long-random-key>:reviewer;scanner-pc:<long-random-key>:operator
API_KEYS=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Offline / privacy controls
OFFLINE_MODE=true
ALLOW_EXTERNAL_NETWORK=false
NETWORK_ALLOWLIST=
DISABLE_TELEMETRY=true
API_DOCS_ENABLED=true
LLM_ENABLED=false
LLM_BASE_URL=
LLM_MODEL=
LLM_ALLOW_EXTERNAL=false
LLM_API_KEY=

# Standard-template IR (fixed 32 sections) read by a LOCAL vision-language model.
# Run any OpenAI-compatible VLM server on this machine (llama.cpp server / Ollama / vLLM),
# e.g. a Nanonets-OCR build, then point the LLM_* settings above at it:
#   LLM_ENABLED=true
#   LLM_BASE_URL=http://127.0.0.1:8081/v1
#   LLM_MODEL=<model name the server reports>
# With IR_STANDARD_ENABLED=true uploads are mapped onto the standard template (JSON + DOCX);
# if the VLM is unreachable the OCR pipeline below is used instead.
# A CPU-only server needs minutes per page: keep ASYNC_PROCESSING=true and raise VLM_TIMEOUT_SECONDS.
IR_STANDARD_ENABLED=false
VLM_TIMEOUT_SECONDS=900
VLM_PAGE_MAX_TOKENS=4096
VLM_SECTION_MAX_TOKENS=2048
VLM_DPI=150

# OCR (local PaddleOCR, Tesseract fallback) — used for scanned PDFs
OCR_ENABLED=true
OCR_LANG=en
OCR_MIN_TEXT_CHARS=40
OCR_DPI=200
OCR_ENABLE_MKLDNN=false
TESSERACT_CMD=

PPSTRUCTURE_ENABLED=true
DOCLING_ENABLED=false
VL_ENABLED=false
VL_REQUIRE_GPU=true
VL_PIPELINE=PaddleOCR-VL
OCR_ACCEPT_MIN_CONFIDENCE=0.70
OCR_USE_ORIENTATION=false
STORE_PAGE_TEXT=false

ASYNC_PROCESSING=true
PROCESSING_TIMEOUT_SECONDS=900
LOG_LEVEL=INFO
LOG_PII=false
