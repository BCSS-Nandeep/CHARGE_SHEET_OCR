# Charge Sheet Extraction Service — local / private deployment only
# Copy to .env and adjust. Never commit real secrets.

APP_NAME=Charge Sheet Extraction Service
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Database: sqlite (default) or postgresql
DATABASE_URL=sqlite:///./data/charge_sheets.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/charge_sheets

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
RETENTION_DAYS=90

# Security — required for API access
API_KEY=change-me-to-a-long-random-secret
API_KEY_HEADER=X-API-Key
# Set true in production / shared networks. false = open local UI (no key).
ENABLE_AUTH=false
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Offline / privacy controls
OFFLINE_MODE=true
ALLOW_EXTERNAL_NETWORK=false
DISABLE_TELEMETRY=true
LLM_ENABLED=false
LLM_BASE_URL=
# Local-only LLM example (optional): http://127.0.0.1:11434
LLM_MODEL=
LLM_ALLOW_EXTERNAL=false

# OCR (local PaddleOCR)
OCR_ENABLED=true
OCR_LANG=en
OCR_MIN_TEXT_CHARS=40
OCR_DPI=200

# Processing
ASYNC_PROCESSING=true
PROCESSING_TIMEOUT_SECONDS=300
LOG_LEVEL=INFO
LOG_PII=false
