# Charge Sheet Extraction Service — local / private deployment only
# Copy to .env and adjust. Never commit real secrets.

APP_NAME=Charge Sheet Extraction Service
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
DEBUG=false

# Database: sqlite (default) or postgresql
DATABASE_URL=sqlite:///./data/charge_sheets.db
# DATABASE_URL=postgresql://user:pass@localhost:5432/charge_sheets

# Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=25
MAX_PAGES=200
# Days after which PDFs, extracted results and corrections are deleted (0 = keep)
RETENTION_DAYS=90

# Authentication
# ENABLE_AUTH=false → only loopback (127.0.0.1) clients are served, as an
#   unauthenticated "operator"; results can NOT be marked verified.
# ENABLE_AUTH=true  → every API call needs a key in API_KEY_HEADER.
ENABLE_AUTH=false
API_KEY_HEADER=X-API-Key
# Admin key (user "default"). At least 16 characters; example values are refused.
API_KEY=
# Named keys with roles (viewer < operator < reviewer < admin), ';'-separated:
# API_KEYS=alice:<long-random-key>:reviewer;scanner-pc:<long-random-key>:operator
API_KEYS=
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Offline / privacy controls
OFFLINE_MODE=true
ALLOW_EXTERNAL_NETWORK=false
# Hostnames the offline network guard may reach (e.g. a private Postgres host)
NETWORK_ALLOWLIST=
DISABLE_TELEMETRY=true
# /docs and /redoc make the browser load Swagger assets from cdn.jsdelivr.net.
API_DOCS_ENABLED=true
LLM_ENABLED=false
LLM_BASE_URL=
# Local-only LLM example (optional): http://127.0.0.1:11434
LLM_MODEL=
LLM_ALLOW_EXTERNAL=false

# OCR (local PaddleOCR, Tesseract fallback)
OCR_ENABLED=true
OCR_LANG=en
OCR_MIN_TEXT_CHARS=40
OCR_DPI=200
# Paddle 3.x oneDNN kernels crash on some CPUs; keep false unless verified
OCR_ENABLE_MKLDNN=false
# Path to tesseract.exe if it is not on PATH
TESSERACT_CMD=

# Hybrid extraction stack (map of chargesheet OCR plan)
# Gate1 router always on. Engines below skip gracefully if not installed.
PPSTRUCTURE_ENABLED=true
# Docling / VL: install packages + prefetch models, then set true
DOCLING_ENABLED=false
VL_ENABLED=false
VL_REQUIRE_GPU=true
VL_PIPELINE=PaddleOCR-VL
OCR_ACCEPT_MIN_CONFIDENCE=0.70
OCR_USE_ORIENTATION=false
# Persist per-page native/OCR text into results JSON (sensitive). Keep false unless needed.
STORE_PAGE_TEXT=false

# Processing
ASYNC_PROCESSING=true
# Time budget per document; OCR stops (extraction marked partial) when exceeded
PROCESSING_TIMEOUT_SECONDS=900
LOG_LEVEL=INFO
LOG_PII=false
